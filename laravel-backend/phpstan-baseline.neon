parameters:
    ignoreErrors:
        # =====================================================================
        # Larastan relation detection - relations not found in models
        # =====================================================================
        - '#Relation .+ is not found in .+ model#'

        # =====================================================================
        # Inline @phpstan-ignore-next-line that no longer match actual errors
        # (from previous fixes that larastan/phpstan resolved differently)
        # =====================================================================
        - '#No error to ignore is reported on line#'
        - '#No error with identifier .+ is reported on line#'

        # =====================================================================
        # Spatie Permission package - dynamic properties and missing classes
        # =====================================================================
        - '#Access to an undefined property Spatie\\\\Permission\\\\#'
        - '#Class Spatie\\\\Permission\\\\Middlewares\\\\.+ not found#'
        - '#Call to an undefined method Spatie\\\\Permission\\\\#'
        - '#Function activity not found#'

        # =====================================================================
        # Laravel Cashier / Stripe - dynamic properties and methods
        # =====================================================================
        - '#Access to an undefined property Laravel\\\\Cashier\\\\#'
        - '#Access to an undefined property Stripe\\\\#'
        - '#Call to an undefined method Laravel\\\\Cashier\\\\#'

        # =====================================================================
        # Pivot model dynamic properties
        # =====================================================================
        - '#Access to an undefined property Illuminate\\\\Database\\\\Eloquent\\\\Relations\\\\Pivot::#'

        # =====================================================================
        # Eloquent Model dynamic properties (from selectRaw, aggregates, pivot)
        # =====================================================================
        - '#Access to an undefined property App\\\\Models\\\\.+::\$total#'
        - '#Access to an undefined property App\\\\Models\\\\.+::\$successful#'
        - '#Access to an undefined property App\\\\Models\\\\.+::\$total_mentions#'
        - '#Access to an undefined property App\\\\Models\\\\.+::\$total_engagement#'
        - '#Access to an undefined property App\\\\Models\\\\.+::\$hour#'
        - '#Access to an undefined property App\\\\Models\\\\.+::\$avg_score#'
        - '#Access to an undefined property App\\\\Models\\\\.+::\$post_count#'
        - '#Access to an undefined property App\\\\Models\\\\User::\$unreadNotifications#'

        # =====================================================================
        # Eloquent Model generic - properties on base Model class
        # =====================================================================
        - '#Access to an undefined property Illuminate\\\\Database\\\\Eloquent\\\\Model::#'

        # =====================================================================
        # Collection/Builder closure parameter type mismatches
        # =====================================================================
        - '#Parameter \#1 .+ expects .+, .+ given#'
        - '#contains unresolvable type#'

        # =====================================================================
        # Builder scope methods called statically
        # =====================================================================
        - '#Call to an undefined method Illuminate\\\\Database\\\\Eloquent\\\\Builder::#'
        - '#Call to an undefined method Illuminate\\\\Database\\\\Eloquent\\\\Model::#'

        # =====================================================================
        # Redis facade - static method detection issues
        # =====================================================================
        - '#Call to an undefined static method Illuminate\\\\Support\\\\Facades\\\\Redis::#'
        - '#static method Redis::eval\(\)#'

        # =====================================================================
        # Request::user() / auth() nullability in controller context
        # =====================================================================
        - '#Call to a member function .+ on .+null#'
        - '#Cannot access property .+ on .+null#'

        # =====================================================================
        # Nullsafe operator usage warnings
        # =====================================================================
        - '#Using nullsafe property access .+ on left side of \?\? is unnecessary#'

        # =====================================================================
        # SocialAccountController placeholder methods
        # =====================================================================
        - '#Method App\\\\Http\\\\Controllers\\\\Api\\\\SocialAccountController::.+ never returns array#'

        # =====================================================================
        # Type coercion / binary operation issues
        # =====================================================================
        - '#Binary operation .+ between string and .+ results in an error#'

        # =====================================================================
        # Always-true conditions from type inference
        # =====================================================================
        - '#If condition is always true#'
        - '#Ternary operator condition is always true#'
        - '#Call to function is_array\(\) with .+ will always evaluate to true#'
        - '#Result of && is always true#'
        - '#Variable .+ in empty\(\) always exists and is not falsy#'

        # =====================================================================
        # Unreachable code
        # =====================================================================
        - '#Unreachable statement - code above always terminates#'

        # =====================================================================
        # Constructor parameter mismatches
        # =====================================================================
        - '#Class App\\\\Services\\\\AIManagerConnectionStatus constructor invoked with#'

        # =====================================================================
        # Method parameter type mismatches
        # =====================================================================
        - '#Parameter \#1 \$params of method App\\\\Services\\\\AIManagerService::optimizeWorkflow\(\) expects array, int given#'
        - '#Parameter \#1 \$group of method .+ expects App\\\\Models\\\\DiscoveredGroup, Illuminate\\\\Database\\\\Eloquent\\\\Model given#'

        # =====================================================================
        # Return type issues
        # =====================================================================
        - '#Method App\\\\Models\\\\AccountCreationTask::getDuration\(\) should return int\|null but returns float#'

        # =====================================================================
        # Ignored error patterns from previous config that no longer match
        # =====================================================================
        - '#Ignored error pattern .+ was not matched in reported errors#'
