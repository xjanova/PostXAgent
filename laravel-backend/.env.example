APP_NAME=PostXAgent
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=postxagent
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=postxagent

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# AI Manager Connection
AI_MANAGER_HOST=localhost
AI_MANAGER_API_PORT=5000
AI_MANAGER_SIGNALR_PORT=5002
AI_MANAGER_USE_SSL=false
AI_MANAGER_TIMEOUT=30

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Social Media APIs
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
YOUTUBE_API_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# GPU Cloud Providers
GPU_DEFAULT_PROVIDER=vast_ai

# Vast.ai
VAST_AI_ENABLED=true
VAST_AI_API_URL=https://console.vast.ai/api/v0

# RunPod
RUNPOD_ENABLED=true
RUNPOD_API_URL=https://api.runpod.io
RUNPOD_GRAPHQL_URL=https://api.runpod.io/graphql

# GPU Pool Settings
GPU_POOL_ROTATION_STRATEGY=most_credits
GPU_POOL_COOLDOWN_MINUTES=60
GPU_POOL_MIN_CREDITS=0.50
GPU_POOL_AUTO_FAILOVER=true

# GPU Instance Settings
GPU_DEFAULT_DISK_GB=50
GPU_MAX_INSTANCES_PER_USER=10

# GPU Balance Monitoring
GPU_LOW_BALANCE_THRESHOLD=1.00
GPU_BALANCE_REFRESH_MINUTES=60
GPU_NOTIFY_LOW_BALANCE=true

# Generation Server
GENERATION_SERVER_PORT=5050
GENERATION_SERVER_MODELS_DIR=/workspace/models
GENERATION_SERVER_LOW_VRAM=false

# Content Pipeline
PIPELINE_QUEUE=pipeline
PIPELINE_MAX_CONCURRENT_RUNS=3

# Thai TTS
GOOGLE_TTS_API_KEY=
EDGE_TTS_VOICE_FEMALE=th-TH-PremwadeeNeural
EDGE_TTS_VOICE_MALE=th-TH-NiwatNeural

# Lip Sync
SADTALKER_PATH=
SADTALKER_CHECKPOINT_DIR=
WAV2LIP_PATH=

# Pipeline Media
ROYALTY_FREE_MUSIC_DIR=
PIPELINE_STORAGE_PATH=storage/app/pipeline
