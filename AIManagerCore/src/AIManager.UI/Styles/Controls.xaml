                                        <GradientStop Color="#80C084FC" Offset="0"/>
                                        <GradientStop Color="#60EC4899" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="thumb" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#C084FC" BlurRadius="15" ShadowDepth="0" Opacity="0.7"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumb" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#A0C084FC" Offset="0"/>
                                        <GradientStop Color="#80EC4899" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
