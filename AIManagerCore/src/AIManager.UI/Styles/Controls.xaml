    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Beautiful Animated Progress Bar Styles                          -->
    <!-- Use with AnimatedProgressBarHelper for running light effect     -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- Standard Progress Bar (Purple to Green Gradient) -->
    <Style x:Key="AnimatedProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="12"/>
        <Setter Property="Background" Value="#2D2D4A"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#C084FC" Offset="0"/>
                    <GradientStop Color="#EC4899" Offset="0.5"/>
                    <GradientStop Color="#10B981" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <!-- Background track with rounded corners -->
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"/>
                        <!-- Progress fill with rounded corners -->
                        <Border x:Name="PART_Track" CornerRadius="6" ClipToBounds="True">
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="6"
                                    HorizontalAlignment="Left"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

