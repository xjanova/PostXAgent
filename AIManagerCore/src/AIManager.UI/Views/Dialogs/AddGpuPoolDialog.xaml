<UserControl x:Class="AIManager.UI.Views.Dialogs.AddGpuPoolDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="480"
             Background="#1A1A2E">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="FolderMultiple" Width="28" Height="28" Foreground="#8B5CF6" VerticalAlignment="Center"/>
            <TextBlock Text="Create GPU Account Pool" FontSize="18" FontWeight="Bold" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Pool Name -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Pool Name" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtPoolName"
                     Text=""
                     Background="#2D2D4A" Foreground="White" BorderThickness="0"
                     Padding="12,10" FontSize="14">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <TextBlock Text="A friendly name to identify this pool"
                       FontSize="11" Foreground="#6B6B8A" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Rotation Strategy -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Rotation Strategy" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbRotationStrategy"
                      Background="#2D2D4A" Foreground="White" BorderThickness="0"
                      Padding="12,10" FontSize="14"
                      Style="{StaticResource MaterialDesignComboBox}">
                <ComboBoxItem Content="Most Credits First" Tag="most_credits" IsSelected="True"/>
                <ComboBoxItem Content="Round Robin" Tag="round_robin"/>
                <ComboBoxItem Content="Random" Tag="random"/>
                <ComboBoxItem Content="Least Used" Tag="least_used"/>
                <ComboBoxItem Content="Priority Based" Tag="priority"/>
            </ComboBox>
            <TextBlock Text="How to select accounts when provisioning instances"
                       FontSize="11" Foreground="#6B6B8A" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Min Credits Threshold -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock Text="Minimum Credits Threshold ($)" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtMinCredits"
                     Text="0.50"
                     Background="#2D2D4A" Foreground="White" BorderThickness="0"
                     Padding="12,10" FontSize="14">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <TextBlock Text="Skip accounts with balance below this threshold"
                       FontSize="11" Foreground="#6B6B8A" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Cooldown Period -->
        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="Cooldown Period (minutes)" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtCooldownMinutes"
                     Text="60"
                     Background="#2D2D4A" Foreground="White" BorderThickness="0"
                     Padding="12,10" FontSize="14">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <TextBlock Text="Wait time before reusing an account after provisioning"
                       FontSize="11" Foreground="#6B6B8A" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Auto Failover -->
        <StackPanel Grid.Row="5" Margin="0,0,0,16" Orientation="Horizontal">
            <CheckBox x:Name="ChkAutoFailover"
                      IsChecked="True"
                      Foreground="White"
                      Style="{StaticResource MaterialDesignCheckBox}"/>
            <StackPanel Margin="8,0,0,0">
                <TextBlock Text="Enable Auto Failover" FontSize="13" Foreground="White"/>
                <TextBlock Text="Automatically try next account if provisioning fails"
                           FontSize="11" Foreground="#6B6B8A"/>
            </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#2D2D4A" CornerRadius="8" Padding="20,10">
                            <TextBlock Text="Cancel" FontSize="13" Foreground="#9090A8"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Create Pool" Click="Create_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Padding="24,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Create Pool" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
