<UserControl x:Class="AIManager.UI.Views.Dialogs.EditGpuPoolDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="480"
             Background="#1A1A2E">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="FolderEdit" Width="28" Height="28" Foreground="#8B5CF6" VerticalAlignment="Center"/>
            <TextBlock Text="Edit GPU Pool" FontSize="18" FontWeight="Bold" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Pool Name -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Pool Name" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtPoolName"
                     Background="#2D2D4A" Foreground="White" BorderThickness="0"
                     Padding="12,10" FontSize="14">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
        </StackPanel>

        <!-- Rotation Strategy -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Rotation Strategy" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbRotationStrategy"
                      Background="#2D2D4A" Foreground="White" BorderThickness="0"
                      Padding="12,10" FontSize="14"
                      Style="{StaticResource MaterialDesignComboBox}">
                <ComboBoxItem Content="Most Credits First" Tag="most_credits"/>
                <ComboBoxItem Content="Round Robin" Tag="round_robin"/>
                <ComboBoxItem Content="Random" Tag="random"/>
                <ComboBoxItem Content="Least Used" Tag="least_used"/>
                <ComboBoxItem Content="Priority Based" Tag="priority"/>
            </ComboBox>
        </StackPanel>

        <!-- Pool Stats (Read Only) -->
        <Border Grid.Row="3" Background="#15FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtActiveAccounts" Text="0" FontSize="20" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                    <TextBlock Text="Accounts" FontSize="11" Foreground="#6B6B8A" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtTotalCredits" Text="$0.00" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Credits" FontSize="11" Foreground="#6B6B8A" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtInstancesToday" Text="0" FontSize="20" FontWeight="Bold" Foreground="#6366F1" HorizontalAlignment="Center"/>
                    <TextBlock Text="Today" FontSize="11" Foreground="#6B6B8A" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#2D2D4A" CornerRadius="8" Padding="20,10">
                            <TextBlock Text="Cancel" FontSize="13" Foreground="#9090A8"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Save" Click="Save_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Padding="24,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Save" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
