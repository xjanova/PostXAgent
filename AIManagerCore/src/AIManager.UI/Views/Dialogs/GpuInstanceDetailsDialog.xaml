<UserControl x:Class="AIManager.UI.Views.Dialogs.GpuInstanceDetailsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="560"
             MaxHeight="550"
             Background="#1A1A2E">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Server" Width="28" Height="28" Foreground="#60A5FA" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTitle" Text="GPU Instance Details" FontSize="18" FontWeight="Bold" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Background="#2D2D4A" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="StatusBadge" CornerRadius="4" Padding="8,4" Background="#10B981">
                        <TextBlock x:Name="TxtStatus" Text="Running" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="TxtInstanceId" Text="Instance ID: vast-12345" FontSize="12" Foreground="#9090A8" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Details ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Provider Info -->
                <Border Background="#2D2D4A" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Provider Information" FontSize="14" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider:" Foreground="#9090A8" FontSize="13"/>
                            <TextBlock x:Name="TxtProvider" Grid.Row="0" Grid.Column="1" Text="Vast.ai" Foreground="White" FontSize="13"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Account:" Foreground="#9090A8" FontSize="13" Margin="0,8,0,0"/>
                            <TextBlock x:Name="TxtAccount" Grid.Row="1" Grid.Column="1" Text="My Account" Foreground="White" FontSize="13" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Provider Instance:" Foreground="#9090A8" FontSize="13" Margin="0,8,0,0"/>
                            <TextBlock x:Name="TxtProviderInstanceId" Grid.Row="2" Grid.Column="1" Text="123456" Foreground="White" FontSize="13" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hardware Info -->
                <Border Background="#2D2D4A" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Hardware Specifications" FontSize="14" FontWeight="SemiBold" Foreground="#10B981" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="GPU Model:" Foreground="#9090A8" FontSize="13"/>
                            <TextBlock x:Name="TxtGpuModel" Grid.Row="0" Grid.Column="1" Text="NVIDIA RTX 4090" Foreground="White" FontSize="13"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU Memory:" Foreground="#9090A8" FontSize="13" Margin="0,8,0,0"/>
                            <TextBlock x:Name="TxtGpuMemory" Grid.Row="1" Grid.Column="1" Text="24 GB" Foreground="White" FontSize="13" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU Cores:" Foreground="#9090A8" FontSize="13" Margin="0,8,0,0"/>
                            <TextBlock x:Name="TxtCpuCores" Grid.Row="2" Grid.Column="1" Text="16 cores" Foreground="White" FontSize="13" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="RAM:" Foreground="#9090A8" FontSize="13" Margin="0,8,0,0"/>
                            <TextBlock x:Name="TxtRam" Grid.Row="3" Grid.Column="1" Text="64 GB" Foreground="White" FontSize="13" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Disk:" Foreground="#9090A8" FontSize="13" Margin="0,8,0,0"/>
                            <TextBlock x:Name="TxtDisk" Grid.Row="4" Grid.Column="1" Text="100 GB SSD" Foreground="White" FontSize="13" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Connection Info -->
                <Border Background="#2D2D4A" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Connection Details" FontSize="14" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP Address:" Foreground="#9090A8" FontSize="13"/>
                            <TextBlock x:Name="TxtIpAddress" Grid.Row="0" Grid.Column="1" Text="192.168.1.100" Foreground="White" FontSize="13"/>
                            <Button Grid.Row="0" Grid.Column="2" Click="CopyIpAddress_Click" Cursor="Hand" ToolTip="Copy IP">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Foreground="#9090A8"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="SSH Port:" Foreground="#9090A8" FontSize="13" Margin="0,8,0,0"/>
                            <TextBlock x:Name="TxtSshPort" Grid.Row="1" Grid.Column="1" Text="22" Foreground="White" FontSize="13" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Cost Info -->
                <Border Background="#2D2D4A" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Cost Information" FontSize="14" FontWeight="SemiBold" Foreground="#EF4444" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Hourly Rate:" Foreground="#9090A8" FontSize="13"/>
                            <TextBlock x:Name="TxtHourlyRate" Grid.Row="0" Grid.Column="1" Text="$0.50/hr" Foreground="White" FontSize="13"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Cost:" Foreground="#9090A8" FontSize="13" Margin="0,8,0,0"/>
                            <TextBlock x:Name="TxtTotalCost" Grid.Row="1" Grid.Column="1" Text="$5.25" Foreground="#EF4444" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Started:" Foreground="#9090A8" FontSize="13" Margin="0,8,0,0"/>
                            <TextBlock x:Name="TxtStartedAt" Grid.Row="2" Grid.Column="1" Text="2025-01-23 10:30:00" Foreground="White" FontSize="13" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Runtime:" Foreground="#9090A8" FontSize="13" Margin="0,8,0,0"/>
                            <TextBlock x:Name="TxtRuntime" Grid.Row="3" Grid.Column="1" Text="10h 30m" Foreground="White" FontSize="13" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnTerminate" Content="Terminate" Click="Terminate_Click" Margin="0,0,8,0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#7F1D1D" CornerRadius="8" Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Stop" Width="16" Height="16" Foreground="#FCA5A5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Terminate" FontSize="13" Foreground="#FCA5A5"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="SSH Connect" Click="SshConnect_Click" Margin="0,0,8,0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#3D3D5A" CornerRadius="8" Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Console" Width="16" Height="16" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="SSH" FontSize="13" Foreground="#60A5FA"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Close" Click="Close_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#2D2D4A" CornerRadius="8" Padding="20,10">
                            <TextBlock Text="Close" FontSize="13" Foreground="#9090A8"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
