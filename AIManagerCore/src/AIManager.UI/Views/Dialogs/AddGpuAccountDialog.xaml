<UserControl x:Class="AIManager.UI.Views.Dialogs.AddGpuAccountDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="480"
             Background="#1A1A2E">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <materialDesign:PackIcon x:Name="ProviderIcon" Kind="CloudPlus" Width="28" Height="28" Foreground="#10B981" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtTitle" Text="Add GPU Provider Account" FontSize="18" FontWeight="Bold" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Account Name -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Account Name" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtAccountName"
                     Text=""
                     Background="#2D2D4A" Foreground="White" BorderThickness="0"
                     Padding="12,10" FontSize="14">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <TextBlock Text="A friendly name to identify this account"
                       FontSize="11" Foreground="#6B6B8A" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Provider -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Provider" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbProvider"
                      Background="#2D2D4A" Foreground="White" BorderThickness="0"
                      Padding="12,10" FontSize="14"
                      Style="{StaticResource MaterialDesignComboBox}">
                <ComboBoxItem Content="Vast.ai" Tag="vast_ai" IsSelected="True"/>
                <ComboBoxItem Content="RunPod" Tag="runpod"/>
                <ComboBoxItem Content="Lambda Labs" Tag="lambda"/>
                <ComboBoxItem Content="Lightning.ai" Tag="lightning"/>
            </ComboBox>
        </StackPanel>

        <!-- API Key -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock Text="API Key" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="TxtApiKey"
                             Grid.Column="0"
                             Background="#2D2D4A" Foreground="White" BorderThickness="0"
                             Padding="12,10" FontSize="14">
                    <PasswordBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8,0,0,8"/>
                        </Style>
                    </PasswordBox.Resources>
                </PasswordBox>
                <Button Grid.Column="1" Click="ToggleApiKeyVisibility_Click" Cursor="Hand" ToolTip="Show/Hide API Key">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#3D3D5A" CornerRadius="0,8,8,0" Padding="12,10">
                                <materialDesign:PackIcon x:Name="EyeIcon" Kind="Eye" Width="16" Height="16" Foreground="#9090A8"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <TextBlock Text="Your API key from the provider dashboard"
                       FontSize="11" Foreground="#6B6B8A" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Email (Optional) -->
        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="Email (Optional)" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtEmail"
                     Text=""
                     Background="#2D2D4A" Foreground="White" BorderThickness="0"
                     Padding="12,10" FontSize="14">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
        </StackPanel>

        <!-- Notes (Optional) -->
        <StackPanel Grid.Row="5" Margin="0,0,0,16">
            <TextBlock Text="Notes (Optional)" FontSize="12" Foreground="#9090A8" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtNotes"
                     Text=""
                     Background="#2D2D4A" Foreground="White" BorderThickness="0"
                     Padding="12,10" FontSize="14"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Height="60"
                     VerticalContentAlignment="Top">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#2D2D4A" CornerRadius="8" Padding="20,10">
                            <TextBlock Text="Cancel" FontSize="13" Foreground="#9090A8"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Test Connection" Click="TestConnection_Click" Margin="0,0,8,0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#3D3D5A" CornerRadius="8" Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Connection" Width="16" Height="16" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Test" FontSize="13" Foreground="#60A5FA"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Save" Click="Save_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Padding="24,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10B981" Offset="0"/>
                                    <GradientStop Color="#059669" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Save" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
