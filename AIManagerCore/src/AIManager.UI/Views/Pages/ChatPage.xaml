<Page x:Class="AIManager.UI.Views.Pages.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="AI Chat">

    <Page.Resources>
        <!-- AI Message Bubble Style (Purple-Blue Gradient) -->
        <Style x:Key="AiMessageBubble" TargetType="Border">
            <Setter Property="CornerRadius" Value="16,16,16,4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,60,12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="600"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E1E3F" Offset="0"/>
                        <GradientStop Color="#252552" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#C084FC" BlurRadius="15" ShadowDepth="0" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- User Message Bubble Style (Cyan-Purple Gradient) -->
        <Style x:Key="UserMessageBubble" TargetType="Border">
            <Setter Property="CornerRadius" Value="16,16,4,16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="60,0,0,12"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="600"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A3A4A" Offset="0"/>
                        <GradientStop Color="#1E2A52" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#06B6D4" BlurRadius="15" ShadowDepth="0" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Card Style -->
        <Style x:Key="FuturisticHeaderCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E1E2E" Offset="0"/>
                        <GradientStop Color="#252540" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#30C084FC" Offset="0"/>
                        <GradientStop Color="#20EC4899" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#C084FC" BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input Card Style -->
        <Style x:Key="FuturisticInputCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A1A2E" Offset="0"/>
                        <GradientStop Color="#1E1E38" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#25C084FC" Offset="0"/>
                        <GradientStop Color="#1506B6D4" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#06B6D4" BlurRadius="15" ShadowDepth="0" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Futuristic Icon Button -->
        <Style x:Key="FuturisticIconButton" TargetType="Button">
            <Setter Property="Background" Value="#20C084FC"/>
            <Setter Property="Foreground" Value="#C084FC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="12" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#35C084FC"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#C084FC" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45C084FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Send Button Style -->
        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#C084FC" Offset="0"/>
                                    <GradientStop Color="#EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#C084FC" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#EC4899" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stop Button Style -->
        <Style x:Key="StopButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EF4444" Offset="0"/>
                                    <GradientStop Color="#DC2626" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#EF4444" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#EF4444" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#0D0D15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Futuristic Header -->
        <Border Grid.Row="0" Style="{StaticResource FuturisticHeaderCard}" Margin="20,20,20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- AI Avatar and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Animated AI Avatar -->
                    <Border Width="48" Height="48" CornerRadius="14" Margin="0,0,15,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#C084FC" Offset="0"/>
                                <GradientStop Color="#EC4899" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#C084FC" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="Robot" Width="28" Height="28"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="White">
                            <Run Text="AI Chat"/>
                            <Run Text=" - " Foreground="#808080"/>
                            <Run Text="Ollama" Foreground="#C084FC"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#059669" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="TxtStatus" Text="Connecting..." FontSize="12" Foreground="#808080"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Model Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,15,0">
                    <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="#A0A0A0" FontSize="13"/>
                    <ComboBox x:Name="CboModel" Width="200"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Foreground="White"
                              SelectionChanged="CboModel_SelectionChanged"/>
                </StackPanel>

                <!-- Clear Chat Button -->
                <Button Grid.Column="2" Content="Clear Chat" Click="ClearChat_Click"
                        Style="{StaticResource OutlineButton}"
                        Padding="12,8"/>
            </Grid>
        </Border>

        <!-- Chat Messages Area with Futuristic ScrollViewer -->
        <ScrollViewer x:Name="ChatScroller" Grid.Row="1" Margin="20,0,20,10"
                      Style="{StaticResource FuturisticScrollViewer}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MessagesPanel" Margin="0,0,10,0">
                <!-- Welcome Message with Futuristic Style -->
                <Border Style="{StaticResource AiMessageBubble}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#C084FC" Offset="0"/>
                                        <GradientStop Color="#C084FC" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="Robot" Width="16" Height="16"
                                                         Foreground="White"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="AI Assistant" FontWeight="SemiBold" FontSize="13"
                                       Foreground="#C084FC" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#E0E0E0" LineHeight="22">
                            <Run FontWeight="SemiBold" Foreground="White">สวัสดีครับ!</Run>
                            <Run> ผมคือ AI Assistant พร้อมช่วยเหลือคุณ</Run>
                            <LineBreak/><LineBreak/>
                            <Run Foreground="#C084FC">คุณสามารถ:</Run>
                            <LineBreak/>
                            <Run Foreground="#06B6D4">&#x2022;</Run><Run> ถามคำถามเกี่ยวกับระบบ AIManager</Run>
                            <LineBreak/>
                            <Run Foreground="#EC4899">&#x2022;</Run><Run> แนบรูปภาพเพื่อให้วิเคราะห์ (ต้องใช้ vision model)</Run>
                            <LineBreak/>
                            <Run Foreground="#10B981">&#x2022;</Run><Run> ค้นหาข้อมูลจากเว็บ (คลิกปุ่ม Search)</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Image Preview Panel -->
        <Border x:Name="ImagePreviewPanel" Grid.Row="2"
                Visibility="Collapsed" Margin="20,0,20,10" CornerRadius="12" Padding="12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A1A2E" Offset="0"/>
                    <GradientStop Color="#1E2A3E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#3006B6D4"/>
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0">
                    <Image x:Name="PreviewImage" Width="70" Height="70" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtImageName" Text="image.png" FontSize="13"
                               Foreground="White" FontWeight="Medium"/>
                    <TextBlock Text="Image attached" FontSize="11" Foreground="#808080" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Click="RemoveImage_Click"
                        Style="{StaticResource FuturisticIconButton}"
                        Width="36" Height="36" ToolTip="Remove image">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#EF4444"/>
                </Button>
            </Grid>
        </Border>

        <!-- Futuristic Input Area -->
        <Border Grid.Row="3" Style="{StaticResource FuturisticInputCard}" Margin="20,0,20,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button x:Name="BtnAttachImage" Click="AttachImage_Click"
                            Style="{StaticResource FuturisticIconButton}"
                            ToolTip="Attach Image">
                        <materialDesign:PackIcon Kind="Image" Width="22" Height="22"/>
                    </Button>

                    <Button x:Name="BtnWebSearch" Click="WebSearch_Click" Margin="8,0,0,0"
                            Style="{StaticResource FuturisticIconButton}"
                            ToolTip="Search Web">
                        <materialDesign:PackIcon Kind="Web" Width="22" Height="22"/>
                    </Button>
                </StackPanel>

                <!-- Message Input -->
                <Border Grid.Column="1" CornerRadius="12" Padding="4">
                    <Border.Background>
                        <SolidColorBrush Color="#15FFFFFF"/>
                    </Border.Background>
                    <TextBox x:Name="TxtMessage"
                             materialDesign:HintAssist.Hint="พิมพ์ข้อความ... (Enter ส่ง, Shift+Enter ขึ้นบรรทัดใหม่)"
                             materialDesign:HintAssist.Foreground="#606080"
                             Background="Transparent"
                             Foreground="White"
                             CaretBrush="#C084FC"
                             BorderThickness="0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxHeight="100"
                             FontSize="14"
                             Padding="12,10"
                             VerticalScrollBarVisibility="Auto"
                             KeyDown="TxtMessage_KeyDown"/>
                </Border>

                <!-- Send/Stop Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button x:Name="BtnSend" Click="Send_Click"
                            Style="{StaticResource SendButton}"
                            ToolTip="Send (Ctrl+Enter)">
                        <materialDesign:PackIcon Kind="Send" Width="22" Height="22" Foreground="White"/>
                    </Button>

                    <Button x:Name="BtnStop" Click="Stop_Click" Visibility="Collapsed"
                            Style="{StaticResource StopButton}"
                            Margin="8,0,0,0" ToolTip="Stop">
                        <materialDesign:PackIcon Kind="Stop" Width="22" Height="22" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Futuristic Loading Overlay -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="4" Visibility="Collapsed">
            <Border.Background>
                <SolidColorBrush Color="#0D0D15" Opacity="0.9"/>
            </Border.Background>
            <Grid>
                <!-- Animated glow background -->
                <Ellipse Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#40C084FC" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 Width="50" Height="50"
                                 Foreground="#C084FC"/>
                    <TextBlock x:Name="TxtLoadingMessage" Text="กำลังโหลด..."
                               Foreground="#C084FC" Margin="0,20,0,0"
                               FontSize="14" FontWeight="Medium"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
