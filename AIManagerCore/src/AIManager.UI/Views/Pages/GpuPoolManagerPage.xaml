<Page x:Class="AIManager.UI.Views.Pages.GpuPoolManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1400"
      Title="GPU Pool Manager"
      Background="Transparent"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Card Styles -->
        <Style x:Key="ProviderCard" TargetType="Border">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InstanceCard" TargetType="Border">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Status Colors -->
        <SolidColorBrush x:Key="StatusActive" Color="#10B981"/>
        <SolidColorBrush x:Key="StatusRunning" Color="#10B981"/>
        <SolidColorBrush x:Key="StatusPending" Color="#F59E0B"/>
        <SolidColorBrush x:Key="StatusStopped" Color="#6B7280"/>
        <SolidColorBrush x:Key="StatusError" Color="#EF4444"/>
        <SolidColorBrush x:Key="StatusDepleted" Color="#EF4444"/>

        <!-- Provider Colors -->
        <SolidColorBrush x:Key="VastAiColor" Color="#6366F1"/>
        <SolidColorBrush x:Key="RunPodColor" Color="#8B5CF6"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- HEADER                                                   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#10FFFFFF" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ServerNetwork" Width="32" Height="32"
                                                 Foreground="#8B5CF6" VerticalAlignment="Center"/>
                        <TextBlock Text="GPU Pool Manager" FontSize="24" FontWeight="Bold"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="#6366F1" CornerRadius="6" Padding="10,4" Margin="16,0,0,0">
                            <TextBlock Text="Vast.ai" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#8B5CF6" CornerRadius="6" Padding="10,4" Margin="8,0,0,0">
                            <TextBlock Text="RunPod" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="จัดการ GPU accounts และ instances จาก Vast.ai และ RunPod พร้อม auto-rotation"
                               Opacity="0.6" FontSize="13" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Quick Stats -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="#206366F1" CornerRadius="10" Padding="16,12" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Total Credits" FontSize="11" Opacity="0.7"/>
                            <TextBlock x:Name="TxtTotalCredits" Text="$0.00" FontSize="20" FontWeight="Bold" Foreground="#6366F1"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#2010B981" CornerRadius="10" Padding="16,12" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Active Instances" FontSize="11" Opacity="0.7"/>
                            <TextBlock x:Name="TxtActiveInstances" Text="0" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#20F59E0B" CornerRadius="10" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="Cost/Hour" FontSize="11" Opacity="0.7"/>
                            <TextBlock x:Name="TxtCostPerHour" Text="$0.00" FontSize="20" FontWeight="Bold" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT - Tabs                                      -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                    TabStripPlacement="Left" Margin="0">

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- TAB 1: Accounts                                         -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="100" Height="60">
                        <materialDesign:PackIcon Kind="AccountMultiple" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Accounts" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Actions Bar -->
                        <Border Background="#10FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Filter -->
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="CmbProviderFilter" Width="150" Margin="0,0,16,0"
                                              SelectionChanged="ProviderFilter_Changed">
                                        <ComboBoxItem Content="All Providers" IsSelected="True"/>
                                        <ComboBoxItem Content="Vast.ai" Tag="vast_ai"/>
                                        <ComboBoxItem Content="RunPod" Tag="runpod"/>
                                    </ComboBox>
                                    <ComboBox x:Name="CmbStatusFilter" Width="120"
                                              SelectionChanged="StatusFilter_Changed">
                                        <ComboBoxItem Content="All Status" IsSelected="True"/>
                                        <ComboBoxItem Content="Active" Tag="active"/>
                                        <ComboBoxItem Content="Depleted" Tag="depleted"/>
                                        <ComboBoxItem Content="Error" Tag="error"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Click="RefreshBalances_Click" Margin="0,0,8,0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            ToolTip="Refresh all account balances">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                                            <TextBlock Text="Refresh Balances" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="AddVastAiAccount_Click" Margin="0,0,8,0"
                                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                            Background="#6366F1" Foreground="White">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                                            <TextBlock Text="Add Vast.ai" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="AddRunPodAccount_Click"
                                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                            Background="#8B5CF6" Foreground="White">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                                            <TextBlock Text="Add RunPod" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Account List -->
                        <ItemsControl x:Name="AccountsList" Grid.Row="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProviderCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Provider Icon -->
                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8"
                                                    Background="{Binding ProviderColor}" Margin="0,0,16,0">
                                                <materialDesign:PackIcon Kind="{Binding ProviderIcon}"
                                                                         Width="24" Height="24"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Account Info -->
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                                    <Border Background="{Binding StatusColor}" CornerRadius="4"
                                                            Padding="8,2" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Opacity="0.7">
                                                    <TextBlock Text="{Binding Provider}" FontSize="12"/>
                                                    <TextBlock Text=" | " FontSize="12"/>
                                                    <TextBlock Text="{Binding Email}" FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Counter" Width="14" Height="14" Opacity="0.7"/>
                                                            <TextBlock Text="{Binding InstancesCreated, StringFormat='{}{0} instances'}"
                                                                       Margin="4,0,0,0" FontSize="11"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Clock" Width="14" Height="14" Opacity="0.7"/>
                                                            <TextBlock Text="{Binding LastUsed, StringFormat='Last: {0}'}"
                                                                       Margin="4,0,0,0" FontSize="11"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Credits -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,20,0">
                                                <TextBlock Text="Balance" FontSize="11" Opacity="0.6" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding CreditsBalance, StringFormat='${0:F2}'}"
                                                           FontSize="24" FontWeight="Bold"
                                                           Foreground="{Binding BalanceColor}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding CreditsUsedToday, StringFormat='Today: ${0:F2}'}"
                                                           FontSize="11" Opacity="0.6" HorizontalAlignment="Right"/>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Refresh Balance"
                                                        Click="RefreshAccountBalance_Click"
                                                        Tag="{Binding Id}">
                                                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Edit Account"
                                                        Click="EditAccount_Click"
                                                        Tag="{Binding Id}">
                                                    <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Delete Account"
                                                        Click="DeleteAccount_Click"
                                                        Tag="{Binding Id}"
                                                        Foreground="#EF4444">
                                                    <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State -->
                        <Border x:Name="AccountsEmptyState" Grid.Row="1" Background="#10FFFFFF"
                                CornerRadius="16" Padding="60" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ServerNetwork" Width="64" Height="64"
                                                         Opacity="0.3" HorizontalAlignment="Center"/>
                                <TextBlock Text="No GPU Accounts" FontSize="20" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,20,0,0" Opacity="0.6"/>
                                <TextBlock Text="Add your Vast.ai or RunPod accounts to start using cloud GPUs"
                                           HorizontalAlignment="Center" Opacity="0.4" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                                    <Button Click="AddVastAiAccount_Click" Margin="0,0,12,0"
                                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                            Background="#6366F1" Foreground="White">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                                            <TextBlock Text="Add Vast.ai Account" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="AddRunPodAccount_Click"
                                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                            Background="#8B5CF6" Foreground="White">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                                            <TextBlock Text="Add RunPod Account" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- TAB 2: Pools                                            -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="100" Height="60">
                        <materialDesign:PackIcon Kind="Layers" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Pools" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
                            <Button Click="CreatePool_Click"
                                    Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                    Background="#10B981" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                                    <TextBlock Text="Create Pool" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Pool List -->
                        <ItemsControl x:Name="PoolsList" Grid.Row="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProviderCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Opacity="0.7">
                                                        <TextBlock Text="{Binding Provider}" FontSize="12"/>
                                                        <TextBlock Text=" | " FontSize="12"/>
                                                        <TextBlock Text="{Binding RotationStrategy}" FontSize="12"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                                            ToolTip="Pool Settings"
                                                            Click="EditPool_Click"
                                                            Tag="{Binding Id}">
                                                        <materialDesign:PackIcon Kind="Cog" Width="20" Height="20"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Stats -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                                                <Border Background="#2010B981" CornerRadius="8" Padding="12,8" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" Foreground="#10B981"/>
                                                        <TextBlock Text="{Binding ActiveAccounts, StringFormat='{}{0} Active'}" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#206366F1" CornerRadius="8" Padding="12,8" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CurrencyUsd" Width="16" Height="16" Foreground="#6366F1"/>
                                                        <TextBlock Text="{Binding TotalCredits, StringFormat='${0:F2}'}" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#20F59E0B" CornerRadius="8" Padding="12,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Server" Width="16" Height="16" Foreground="#F59E0B"/>
                                                        <TextBlock Text="{Binding InstancesToday, StringFormat='{}{0} today'}" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Members -->
                                            <Border Grid.Row="2" Background="#10FFFFFF" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                                <ItemsControl ItemsSource="{Binding Members}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#20FFFFFF" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}"/>
                                                                    <TextBlock Text="{Binding AccountName}" Margin="8,0,8,0" FontSize="12"/>
                                                                    <TextBlock Text="{Binding Credits, StringFormat='${0:F2}'}"
                                                                               FontSize="12" Opacity="0.7"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- TAB 3: Instances                                        -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="100" Height="60">
                        <materialDesign:PackIcon Kind="Server" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Instances" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Actions -->
                        <Border Background="#10FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="CmbInstanceStatusFilter" Width="120"
                                              SelectionChanged="InstanceStatusFilter_Changed">
                                        <ComboBoxItem Content="All" IsSelected="True"/>
                                        <ComboBoxItem Content="Running" Tag="running"/>
                                        <ComboBoxItem Content="Stopped" Tag="stopped"/>
                                        <ComboBoxItem Content="Pending" Tag="pending"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Click="SyncAllInstances_Click" Margin="0,0,8,0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Sync" Width="18" Height="18"/>
                                            <TextBlock Text="Sync All" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ProvisionInstance_Click"
                                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                            Background="#10B981" Foreground="White">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="RocketLaunch" Width="18" Height="18"/>
                                            <TextBlock Text="Provision New" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Instance List -->
                        <ItemsControl x:Name="InstancesList" Grid.Row="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InstanceCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Status Indicator -->
                                            <Border Grid.Column="0" Width="4" CornerRadius="2"
                                                    Background="{Binding StatusColor}" Margin="0,0,16,0"/>

                                            <!-- Instance Info -->
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding GpuType}" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding GpuCount, StringFormat=' x{0}'}"
                                                               FontSize="14" Opacity="0.7" VerticalAlignment="Bottom"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Opacity="0.7">
                                                    <TextBlock Text="{Binding Provider}" FontSize="12"/>
                                                    <TextBlock Text=" | " FontSize="12"/>
                                                    <TextBlock Text="{Binding InstanceId}" FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding CpuCores, StringFormat='{}{0} CPU'}" FontSize="11"/>
                                                    </Border>
                                                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding RamGb, StringFormat='{}{0}GB RAM'}" FontSize="11"/>
                                                    </Border>
                                                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding DiskGb, StringFormat='{}{0}GB Disk'}" FontSize="11"/>
                                                    </Border>
                                                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Region}" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Cost & Time -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,20,0">
                                                <TextBlock Text="{Binding PricePerHour, StringFormat='${0:F3}/hr'}"
                                                           FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding CurrentCost, StringFormat='Total: ${0:F2}'}"
                                                           FontSize="12" Opacity="0.7" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding RuntimeMinutes, StringFormat='Runtime: {0} min'}"
                                                           FontSize="11" Opacity="0.5" HorizontalAlignment="Right"/>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="SSH Command"
                                                        Click="CopySshCommand_Click"
                                                        Tag="{Binding SshCommand}"
                                                        Visibility="{Binding CanConnect}">
                                                    <materialDesign:PackIcon Kind="Console" Width="20" Height="20"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Start Instance"
                                                        Click="StartInstance_Click"
                                                        Tag="{Binding Id}"
                                                        Visibility="{Binding CanStart}">
                                                    <materialDesign:PackIcon Kind="Play" Width="20" Height="20" Foreground="#10B981"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Stop Instance"
                                                        Click="StopInstance_Click"
                                                        Tag="{Binding Id}"
                                                        Visibility="{Binding CanStop}">
                                                    <materialDesign:PackIcon Kind="Stop" Width="20" Height="20" Foreground="#F59E0B"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Terminate Instance"
                                                        Click="TerminateInstance_Click"
                                                        Tag="{Binding Id}"
                                                        Foreground="#EF4444">
                                                    <materialDesign:PackIcon Kind="DeleteForever" Width="20" Height="20"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State -->
                        <Border x:Name="InstancesEmptyState" Grid.Row="1" Background="#10FFFFFF"
                                CornerRadius="16" Padding="60" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Server" Width="64" Height="64"
                                                         Opacity="0.3" HorizontalAlignment="Center"/>
                                <TextBlock Text="No Active Instances" FontSize="20" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,20,0,0" Opacity="0.6"/>
                                <TextBlock Text="Provision a new GPU instance to get started"
                                           HorizontalAlignment="Center" Opacity="0.4" Margin="0,8,0,0"/>
                                <Button Click="ProvisionInstance_Click" Margin="0,24,0,0"
                                        Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                        Background="#10B981" Foreground="White">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="RocketLaunch" Width="18" Height="18"/>
                                        <TextBlock Text="Provision GPU Instance" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- TAB 4: Activity Log                                     -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="100" Height="60">
                        <materialDesign:PackIcon Kind="History" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Activity" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <ItemsControl x:Name="ActivityLogsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#10FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0" Kind="{Binding EventIcon}"
                                                                 Width="20" Height="20"
                                                                 Foreground="{Binding EventColor}"
                                                                 Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Message}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Details}" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding TimeAgo}"
                                                   FontSize="11" Opacity="0.5"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
