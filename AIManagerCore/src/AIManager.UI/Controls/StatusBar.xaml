<UserControl x:Class="AIManager.UI.Controls.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Height="36">

    <UserControl.Resources>
        <!-- Status Indicator Base Style - Compact -->
        <Style x:Key="StatusIndicatorBase" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#18FFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Pill Badge Style - Compact -->
        <Style x:Key="PillBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#20FFFFFF" Offset="0"/>
                        <GradientStop Color="#10FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Separator Style - Compact -->
        <Style x:Key="StatusSeparator" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#30FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Container with Glass Effect -->
    <Border>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#35000000" Offset="0"/>
                <GradientStop Color="#25000000" Offset="0.3"/>
                <GradientStop Color="#25000000" Offset="0.7"/>
                <GradientStop Color="#35000000" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="-3" Direction="90" Opacity="0.4"/>
        </Border.Effect>

        <!-- Top Accent Line -->
        <Border BorderThickness="0,1,0,0">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00C084FC" Offset="0"/>
                    <GradientStop Color="#60C084FC" Offset="0.3"/>
                    <GradientStop Color="#60EC4899" Offset="0.7"/>
                    <GradientStop Color="#00EC4899" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Service Status Indicators with Scrollbar -->
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,4,0,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Ollama Status -->
                        <Border x:Name="OllamaStatus" Style="{StaticResource StatusIndicatorBase}"
                                ToolTip="Ollama (Local LLM)" MouseLeftButtonDown="OllamaStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" Margin="0,0,5,0">
                                    <Ellipse x:Name="OllamaGlow" Fill="#4CAF50" Opacity="0.3">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="OllamaIndicator" Width="6" Height="6" Fill="#9E9E9E"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Ollama" FontSize="10" FontWeight="Medium" Foreground="#D0D0D0"/>
                            </StackPanel>
                        </Border>

                        <!-- Diffusers Engine Status -->
                        <Border x:Name="DiffusersStatus" Style="{StaticResource StatusIndicatorBase}"
                                ToolTip="Diffusers Engine (Image/Video Generation)" MouseLeftButtonDown="DiffusersStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" Margin="0,0,5,0">
                                    <Ellipse x:Name="DiffusersGlow" Fill="#A855F7" Opacity="0.3">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="DiffusersIndicator" Width="6" Height="6" Fill="#9E9E9E"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="TxtDiffusersEngineStatus" Text="Diffusers" FontSize="10" FontWeight="Medium" Foreground="#D0D0D0"/>
                                <!-- Model Badge - Compact -->
                                <Border x:Name="DiffusersModelBadge" CornerRadius="6" Padding="4,1" Margin="4,0,0,0"
                                        Visibility="Collapsed" Background="#25A855F7" BorderBrush="#40A855F7" BorderThickness="1">
                                    <TextBlock x:Name="TxtDiffusersModel" Text="" FontSize="8" FontWeight="Medium" Foreground="#D8B4FE"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ComfyUI Status - Hidden by default (less common) -->
                        <Border x:Name="ComfyStatus" Style="{StaticResource StatusIndicatorBase}" Visibility="Collapsed"
                                ToolTip="ComfyUI (Image/Video)" MouseLeftButtonDown="ComfyStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" Margin="0,0,5,0">
                                    <Ellipse x:Name="ComfyGlow" Fill="#06B6D4" Opacity="0.3">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="ComfyIndicator" Width="6" Height="6" Fill="#9E9E9E"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="ComfyUI" FontSize="10" FontWeight="Medium" Foreground="#D0D0D0"/>
                            </StackPanel>
                        </Border>

                        <!-- HuggingFace Status - Hidden by default -->
                        <Border x:Name="HFStatus" Style="{StaticResource StatusIndicatorBase}" Visibility="Collapsed"
                                ToolTip="HuggingFace" MouseLeftButtonDown="HFStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" Margin="0,0,5,0">
                                    <Ellipse x:Name="HFGlow" Fill="#FFC107" Opacity="0.3">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="HFIndicator" Width="6" Height="6" Fill="#9E9E9E"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="TxtHFStatus" Text="HF" FontSize="10" FontWeight="Medium" Foreground="#D0D0D0"/>
                            </StackPanel>
                        </Border>

                        <!-- GPU Status -->
                        <Border x:Name="GpuStatus" Style="{StaticResource StatusIndicatorBase}"
                                ToolTip="GPU Provider" MouseLeftButtonDown="GpuStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="4" Padding="3,1" Margin="0,0,4,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#25C084FC" Offset="0"/>
                                            <GradientStop Color="#15EC4899" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="Gpu" Width="12" Height="12" Foreground="#C4B5FD" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtGpuStatus" Text="No GPU" FontSize="10" FontWeight="Medium" Foreground="#D0D0D0"/>
                            </StackPanel>
                        </Border>

                        <!-- Separator -->
                        <Border Style="{StaticResource StatusSeparator}"/>

                        <!-- Backend Status -->
                        <Border x:Name="BackendStatus" Style="{StaticResource StatusIndicatorBase}"
                                ToolTip="Laravel Backend" MouseLeftButtonDown="BackendStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" Margin="0,0,5,0">
                                    <Ellipse x:Name="BackendGlow" Fill="#FF5722" Opacity="0.3">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="BackendIndicator" Width="6" Height="6" Fill="#9E9E9E"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Backend" FontSize="10" FontWeight="Medium" Foreground="#D0D0D0"/>
                            </StackPanel>
                        </Border>

                        <!-- Claude Code Status - Hidden by default -->
                        <Border x:Name="ClaudeStatus" Style="{StaticResource StatusIndicatorBase}" Visibility="Collapsed"
                                ToolTip="Claude Code (AI Assistant)" MouseLeftButtonDown="ClaudeStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" Margin="0,0,5,0">
                                    <Ellipse x:Name="ClaudeGlow" Fill="#C084FC" Opacity="0.3">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="ClaudeIndicator" Width="6" Height="6" Fill="#9E9E9E"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="TxtClaudeStatus" Text="Claude" FontSize="10" FontWeight="Medium" Foreground="#D0D0D0"/>
                                <!-- Token Usage Badge -->
                                <Border x:Name="TokenBadge" CornerRadius="6" Padding="4,1" Margin="4,0,0,0"
                                        Visibility="Collapsed" Background="#25C084FC" BorderBrush="#40C084FC" BorderThickness="1">
                                    <TextBlock x:Name="TxtTokenUsage" Text="0%" FontSize="8" FontWeight="SemiBold" Foreground="#C4B5FD"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Separator -->
                        <Border Style="{StaticResource StatusSeparator}"/>

                        <!-- Database Status -->
                        <Border x:Name="DatabaseStatus" Style="{StaticResource StatusIndicatorBase}" ToolTip="Database" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" Margin="0,0,5,0">
                                    <Ellipse x:Name="SqliteGlow" Fill="#4CAF50" Opacity="0.3">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="SqliteIndicator" Width="6" Height="6" Fill="#9E9E9E"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="DB" FontSize="10" FontWeight="Medium" Foreground="#D0D0D0"/>
                                <Border x:Name="MysqlBadge" CornerRadius="4" Padding="4,1" Margin="4,0,0,0"
                                        Visibility="Collapsed" Background="#2510B981" BorderBrush="#4010B981" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="MysqlIndicator" Width="5" Height="5" Fill="#9E9E9E" Margin="0,0,3,0"/>
                                        <TextBlock Text="MySQL" FontSize="8" FontWeight="Medium" Foreground="#B0B0C0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Separator -->
                        <Border Style="{StaticResource StatusSeparator}"/>

                        <!-- Connections Badge -->
                        <Border Style="{StaticResource PillBadge}" ToolTip="Active Connections">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Connection" Width="10" Height="10" Foreground="#4CAF50"
                                                         VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock x:Name="TxtConnections" Text="0" FontSize="9" FontWeight="Bold" Foreground="#4CAF50"/>
                            </StackPanel>
                        </Border>

                        <!-- Requests Badge -->
                        <Border Style="{StaticResource PillBadge}" ToolTip="API Requests">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowLeftRight" Width="10" Height="10" Foreground="#2196F3"
                                                         VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock x:Name="TxtRequests" Text="0" FontSize="9" FontWeight="Bold" Foreground="#2196F3"/>
                            </StackPanel>
                        </Border>

                        <!-- Alerts Badge - Compact -->
                        <Border x:Name="AlertsBadge" CornerRadius="8" Padding="6,2" Visibility="Collapsed"
                                Cursor="Hand" MouseLeftButtonDown="AlertsBadge_Click" Margin="0,0,6,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F44336" Offset="0"/>
                                    <GradientStop Color="#E91E63" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#F44336" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircle" Width="10" Height="10" Foreground="White"
                                                         VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock x:Name="TxtAlerts" Text="0" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <!-- Activity Indicator - Compact -->
                        <StackPanel Orientation="Horizontal" x:Name="ActivityPanel" Visibility="Collapsed" Margin="2,0,0,0">
                            <Border CornerRadius="6" Padding="6,2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#18C084FC" Offset="0"/>
                                        <GradientStop Color="#18EC4899" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <ProgressBar IsIndeterminate="True" Width="40" Height="2"
                                                 Style="{StaticResource MaterialDesignLinearProgressBar}"
                                                 Foreground="#C084FC"/>
                                    <TextBlock x:Name="TxtActivity" Text="" FontSize="9" Margin="6,0,0,0"
                                               FontWeight="Medium" Foreground="#C4B5FD" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Center: Spacer -->
                <Border Grid.Column="1"/>

                <!-- Right: System Info - Compact -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Memory Usage -->
                    <Border Style="{StaticResource PillBadge}" ToolTip="RAM Usage">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Memory" Width="11" Height="11" Foreground="#C084FC"
                                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtMemory" Text="--" FontSize="9" FontWeight="Medium" Foreground="#B0B0C0"/>
                        </StackPanel>
                    </Border>

                    <!-- GPU Memory (if available) -->
                    <Border x:Name="VramPanel" Style="{StaticResource PillBadge}" Visibility="Collapsed" ToolTip="VRAM Usage">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Gpu" Width="11" Height="11" Foreground="#06B6D4"
                                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtVram" Text="--" FontSize="9" FontWeight="Medium" Foreground="#B0B0C0"/>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Border Style="{StaticResource StatusSeparator}"/>

                    <!-- Copyright & Version - Compact -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="8" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#9090A0" Offset="0"/>
                                    <GradientStop Color="#8080A0" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <Run Text="© Xman Studio"/>
                        </TextBlock>
                        <Border CornerRadius="6" Padding="6,2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#20C084FC" Offset="0"/>
                                    <GradientStop Color="#20EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#40C084FC" Offset="0"/>
                                    <GradientStop Color="#40EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                            <TextBlock x:Name="TxtVersion" Text="v1.3.0" FontSize="8" FontWeight="SemiBold">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#C4B5FD" Offset="0"/>
                                        <GradientStop Color="#F9A8D4" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</UserControl>
