<UserControl x:Class="AIManager.UI.Controls.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Height="42">

    <UserControl.Resources>
        <!-- Status Indicator Base Style -->
        <Style x:Key="StatusIndicatorBase" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#20FFFFFF" Offset="0"/>
                        <GradientStop Color="#10FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Pill Badge Style -->
        <Style x:Key="PillBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#25FFFFFF" Offset="0"/>
                        <GradientStop Color="#15FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Separator Style -->
        <Style x:Key="StatusSeparator" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#40FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Container with Glass Effect -->
    <Border>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#35000000" Offset="0"/>
                <GradientStop Color="#25000000" Offset="0.3"/>
                <GradientStop Color="#25000000" Offset="0.7"/>
                <GradientStop Color="#35000000" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="-3" Direction="90" Opacity="0.4"/>
        </Border.Effect>

        <!-- Top Accent Line -->
        <Border BorderThickness="0,1,0,0">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00C084FC" Offset="0"/>
                    <GradientStop Color="#60C084FC" Offset="0.3"/>
                    <GradientStop Color="#60EC4899" Offset="0.7"/>
                    <GradientStop Color="#00EC4899" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Service Status Indicators with Scrollbar -->
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,4,0,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Ollama Status -->
                        <Border x:Name="OllamaStatus" Style="{StaticResource StatusIndicatorBase}"
                                ToolTip="Ollama (Local LLM)" MouseLeftButtonDown="OllamaStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="12" Height="12" Margin="0,0,6,0">
                                    <Ellipse x:Name="OllamaGlow" Fill="#4CAF50" Opacity="0.3">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="5"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="OllamaIndicator" Width="8" Height="8" Fill="#9E9E9E"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Ollama" FontSize="11" FontWeight="Medium" Foreground="#E0E0E0"/>
                            </StackPanel>
                        </Border>

                        <!-- Diffusers Engine Status -->
                        <Border x:Name="DiffusersStatus" Style="{StaticResource StatusIndicatorBase}"
                                ToolTip="Diffusers Engine (Image/Video Generation)" MouseLeftButtonDown="DiffusersStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="12" Height="12" Margin="0,0,6,0">
                                    <Ellipse x:Name="DiffusersGlow" Fill="#A855F7" Opacity="0.3">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="5"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="DiffusersIndicator" Width="8" Height="8" Fill="#9E9E9E"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="TxtDiffusersEngineStatus" Text="Diffusers" FontSize="11" FontWeight="Medium" Foreground="#E0E0E0"/>
                                <!-- Model Badge -->
                                <Border x:Name="DiffusersModelBadge" CornerRadius="8" Padding="6,2" Margin="6,0,0,0"
                                        Visibility="Collapsed" Background="#30A855F7" BorderBrush="#50A855F7" BorderThickness="1">
                                    <TextBlock x:Name="TxtDiffusersModel" Text="" FontSize="9" FontWeight="Medium" Foreground="#D8B4FE"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ComfyUI Status -->
                        <Border x:Name="ComfyStatus" Style="{StaticResource StatusIndicatorBase}"
                                ToolTip="ComfyUI (Image/Video)" MouseLeftButtonDown="ComfyStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="12" Height="12" Margin="0,0,6,0">
                                    <Ellipse x:Name="ComfyGlow" Fill="#06B6D4" Opacity="0.3">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="5"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="ComfyIndicator" Width="8" Height="8" Fill="#9E9E9E"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="ComfyUI" FontSize="11" FontWeight="Medium" Foreground="#E0E0E0"/>
                            </StackPanel>
                        </Border>

                        <!-- HuggingFace Status -->
                        <Border x:Name="HFStatus" Style="{StaticResource StatusIndicatorBase}"
                                ToolTip="HuggingFace" MouseLeftButtonDown="HFStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="12" Height="12" Margin="0,0,6,0">
                                    <Ellipse x:Name="HFGlow" Fill="#FFC107" Opacity="0.3">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="5"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="HFIndicator" Width="8" Height="8" Fill="#9E9E9E"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="TxtHFStatus" Text="HuggingFace" FontSize="11" FontWeight="Medium" Foreground="#E0E0E0"/>
                            </StackPanel>
                        </Border>

                        <!-- GPU Status -->
                        <Border x:Name="GpuStatus" Style="{StaticResource StatusIndicatorBase}"
                                ToolTip="GPU Provider" MouseLeftButtonDown="GpuStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="6" Padding="4,2" Margin="0,0,6,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#30C084FC" Offset="0"/>
                                            <GradientStop Color="#20EC4899" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <materialDesign:PackIcon Kind="Gpu" Width="14" Height="14" Foreground="#C4B5FD" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtGpuStatus" Text="No GPU" FontSize="11" FontWeight="Medium" Foreground="#E0E0E0"/>
                            </StackPanel>
                        </Border>

                        <!-- Separator -->
                        <Border Style="{StaticResource StatusSeparator}"/>

                        <!-- Backend Status -->
                        <Border x:Name="BackendStatus" Style="{StaticResource StatusIndicatorBase}"
                                ToolTip="Laravel Backend" MouseLeftButtonDown="BackendStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="12" Height="12" Margin="0,0,6,0">
                                    <Ellipse x:Name="BackendGlow" Fill="#FF5722" Opacity="0.3">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="5"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="BackendIndicator" Width="8" Height="8" Fill="#9E9E9E"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Backend" FontSize="11" FontWeight="Medium" Foreground="#E0E0E0"/>
                            </StackPanel>
                        </Border>

                        <!-- Claude Code Status -->
                        <Border x:Name="ClaudeStatus" Style="{StaticResource StatusIndicatorBase}"
                                ToolTip="Claude Code (AI Assistant)" MouseLeftButtonDown="ClaudeStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="12" Height="12" Margin="0,0,6,0">
                                    <Ellipse x:Name="ClaudeGlow" Fill="#C084FC" Opacity="0.3">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="5"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="ClaudeIndicator" Width="8" Height="8" Fill="#9E9E9E"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="TxtClaudeStatus" Text="Claude" FontSize="11" FontWeight="Medium" Foreground="#E0E0E0"/>
                                <!-- Token Usage Badge -->
                                <Border x:Name="TokenBadge" CornerRadius="8" Padding="6,2" Margin="6,0,0,0"
                                        Visibility="Collapsed" Background="#30C084FC" BorderBrush="#50C084FC" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#C084FC" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
                                    </Border.Effect>
                                    <TextBlock x:Name="TxtTokenUsage" Text="0%" FontSize="9" FontWeight="SemiBold" Foreground="#C4B5FD"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Separator -->
                        <Border Style="{StaticResource StatusSeparator}"/>

                        <!-- Database Status -->
                        <Border x:Name="DatabaseStatus" Style="{StaticResource StatusIndicatorBase}" ToolTip="Database" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="12" Height="12" Margin="0,0,6,0">
                                    <Ellipse x:Name="SqliteGlow" Fill="#4CAF50" Opacity="0.3">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="5"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="SqliteIndicator" Width="8" Height="8" Fill="#9E9E9E"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="SQLite" FontSize="11" FontWeight="Medium" Foreground="#E0E0E0"/>
                                <Border x:Name="MysqlBadge" CornerRadius="6" Padding="6,2" Margin="6,0,0,0"
                                        Visibility="Collapsed" Background="#3010B981" BorderBrush="#5010B981" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="MysqlIndicator" Width="6" Height="6" Fill="#9E9E9E" Margin="0,0,4,0"/>
                                        <TextBlock Text="MySQL" FontSize="9" FontWeight="Medium" Foreground="#B0B0C0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Separator -->
                        <Border Style="{StaticResource StatusSeparator}"/>

                        <!-- Connections Badge -->
                        <Border Style="{StaticResource PillBadge}">
                            <Border.Effect>
                                <DropShadowEffect Color="#4CAF50" BlurRadius="6" ShadowDepth="0" Opacity="0.2"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Connection" Width="12" Height="12" Foreground="#4CAF50"
                                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtConnections" Text="0" FontSize="10" FontWeight="Bold" Foreground="#4CAF50"/>
                            </StackPanel>
                        </Border>

                        <!-- Requests Badge -->
                        <Border Style="{StaticResource PillBadge}">
                            <Border.Effect>
                                <DropShadowEffect Color="#2196F3" BlurRadius="6" ShadowDepth="0" Opacity="0.2"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowLeftRight" Width="12" Height="12" Foreground="#2196F3"
                                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtRequests" Text="0" FontSize="10" FontWeight="Bold" Foreground="#2196F3"/>
                            </StackPanel>
                        </Border>

                        <!-- Alerts Badge -->
                        <Border x:Name="AlertsBadge" CornerRadius="10" Padding="8,4" Visibility="Collapsed"
                                Cursor="Hand" MouseLeftButtonDown="AlertsBadge_Click" Margin="0,0,8,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F44336" Offset="0"/>
                                    <GradientStop Color="#E91E63" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#F44336" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircle" Width="12" Height="12" Foreground="White"
                                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtAlerts" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <!-- Activity Indicator -->
                        <StackPanel Orientation="Horizontal" x:Name="ActivityPanel" Visibility="Collapsed" Margin="4,0,0,0">
                            <Border CornerRadius="8" Padding="10,4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#20C084FC" Offset="0"/>
                                        <GradientStop Color="#20EC4899" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#C084FC" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <ProgressBar IsIndeterminate="True" Width="50" Height="3"
                                                 Style="{StaticResource MaterialDesignLinearProgressBar}"
                                                 Foreground="#C084FC"/>
                                    <TextBlock x:Name="TxtActivity" Text="" FontSize="10" Margin="8,0,0,0"
                                               FontWeight="Medium" Foreground="#C4B5FD" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Center: Spacer -->
                <Border Grid.Column="1"/>

                <!-- Right: System Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Memory Usage -->
                    <Border Style="{StaticResource PillBadge}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Memory" Width="13" Height="13" Foreground="#C084FC"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtMemory" Text="-- MB" FontSize="10" FontWeight="Medium" Foreground="#B0B0C0"/>
                        </StackPanel>
                    </Border>

                    <!-- GPU Memory (if available) -->
                    <Border x:Name="VramPanel" Style="{StaticResource PillBadge}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Gpu" Width="13" Height="13" Foreground="#06B6D4"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtVram" Text="-- MB" FontSize="10" FontWeight="Medium" Foreground="#B0B0C0"/>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Border Style="{StaticResource StatusSeparator}"/>

                    <!-- Copyright & Version -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="© 2025" FontSize="9" Foreground="#606070" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock FontSize="9" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#C084FC" Offset="0"/>
                                    <GradientStop Color="#EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <Run Text="Xman Studio"/>
                        </TextBlock>
                        <Border CornerRadius="8" Padding="8,3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#25C084FC" Offset="0"/>
                                    <GradientStop Color="#25EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#50C084FC" Offset="0"/>
                                    <GradientStop Color="#50EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                            <Border.Effect>
                                <DropShadowEffect Color="#C084FC" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <TextBlock x:Name="TxtVersion" Text="v1.1.0" FontSize="9" FontWeight="Bold">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#C4B5FD" Offset="0"/>
                                        <GradientStop Color="#F9A8D4" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</UserControl>
